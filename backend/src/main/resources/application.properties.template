spring.application.name=expresofast
spring.datasource.url=jdbc:sqlserver://SERVIDOR:1433;databaseName=ExpresoFastC5J263_II2026;trustServerCertificate=true;
spring.datasource.username=TU_USUARIO
spring.datasource.password=TU_CONTRASEÑA
spring.datasource.driver-class-name=com.microsoft.sqlserver.jdbc.SQLServerDriver
spring.jpa.show-sql=false
spring.jpa.hibernate.ddl-auto=none
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.SQLServerDialect

# JWT settings - usar una clave secreta Base64 de al menos 48 bytes
jwt.secret=CLAVE_SECRETA_BASE64_AQUI
jwt.expiration=3600000

spring.jpa.hibernate.naming.physical-strategy=org.hibernate.boot.model.naming.CamelCaseToUnderscoresNamingStrategy
